{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Module",
            "type": "debugpy",
            "request": "launch",
            "module": "src"
        },
        {
            "name": "Debug salida ficticia",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/flujos/test_salida_lote.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": { "PYDEVD_USE_SYS_MONITORING": "0" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Pre-stock salida ficticia",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/prestock_salida_lote.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": { "PYDEVD_USE_SYS_MONITORING": "0" },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}